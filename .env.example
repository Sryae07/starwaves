# StarWaves 配置示例：复制为 .env 使用（.env 已被 gitignore，不会上传到仓库）

# SQLite 数据库地址（默认即可）
# DATABASE_URL=sqlite:///./data/starwaves.db

# 写接口 API Key（留空 = 本机调试模式，写入放行；公网部署务必设置）
# API_KEY=改成你自己的随机字符串

# 服务监听地址
# HOST=127.0.0.1
# PORT=8000

# ---- 星穹铁道：米游社同步（非官方接口，自行评估风险）----
# 浏览器登录米游社后，抓一个 api-takumi-record.mihoyo.com 请求，复制完整 Cookie
# HKRPG_COOKIE=
# 服务器：cn=国服 / os=国际服
# HKRPG_SERVER=cn
# 指定角色 UID（不填则自动取第一个角色）
# HKRPG_UID=
